AGDB_ZIG_VERSION=0.14.1
AGDB_OPTIMIZE=Debug

AGDB_REGISTRY_PATH=/var/lib/agdb/registry.agdb
AGDB_DATA_ROOT=/var/lib/agdb/tenants
AGDB_RUNNER_PATH=/usr/lib/agdb/sandbox_runner
AGDB_CLOUD_PORT=7070

AGDB_DEPLOY_HOST=
AGDB_DEPLOY_USER=
AGDB_DEPLOY_SSH_KEY=
AGDB_DEPLOY_SSH_PORT=22
AGDB_DEPLOY_DIR=/opt/agdb
AGDB_SERVICE_USER=agdb
AGDB_SHUTDOWN_USER=agdb-shutdown

AGDB_WAKE_LISTEN_ADDR=0.0.0.0
AGDB_WAKE_LISTEN_PORT=5000
AGDB_TARGET_HOST=
AGDB_TARGET_PORT=80
AGDB_WAKE_HEALTH_PATH=/v1/health
AGDB_WAKE_WORKER_THREADS=8
AGDB_WAKE_QUEUE_CAPACITY=256
AGDB_WAKE_CONNECT_TIMEOUT_MS=3000
AGDB_WAKE_IO_TIMEOUT_MS=15000
AGDB_WAKE_POLL_INTERVAL_MS=5000
AGDB_WAKE_POLL_ATTEMPTS=60
AGDB_WAKE_UPSTREAM_BODY_LIMIT=67108864
AGDB_WAKE_REQUEST_HEADER_LIMIT=65536

AGDB_CLOUD_PROVIDER=none
AGDB_OVH_ENDPOINT=
AGDB_OVH_PROJECT_ID=
AGDB_OVH_INSTANCE_ID=
OVH_APP_KEY=
OVH_APP_SECRET=
OVH_CONSUMER_KEY=
AGDB_WAKE_EXEC_COMMAND=

AGDB_IDLE_SHUTDOWN_SECONDS=900
AGDB_SHUTDOWN_INHIBIT_FILE=/run/agdb/shutdown.inhibit
AGDB_SHUTDOWN_DRY_RUN=1
AGDB_LOG_LEVEL=info
